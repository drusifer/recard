{
  "name": "recard",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ui": "node --test tests/uiActions.browser.mjs",
    "test:rtg": "node --test tests/rtgPlaythrough.browser.mjs",
    "test:hostsetup": "node --test tests/hostSetup.browser.mjs",
    "test:newgame": "node --test tests/newGame.browser.mjs",
    "dev": "node tools/devserver.mjs",
    "cards:build": "node tools/rtg/compile.mjs",
    "cards:jobs": "node tools/rtg/genArtJobs.mjs",
    "cards:art": "node tools/imagegen/cli.mjs pack --in build/rtg-art-raw --out assets/cards/rtg",
    "lint": "npm run lint:style && npm run lint:design && npm run lint:js",
    "lint:style": "stylelint style.css",
    "lint:style:fix": "stylelint style.css --fix",
    "lint:design": "node tests/designLint.check.mjs",
    "lint:decks": "node tools/rtg/lintDecks.mjs",
    "lint:js": "eslint 'src/**/*.js' 'tools/**/*.mjs' 'tests/**/*.js' 'tests/**/*.mjs'",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:fix": "npm run lint:style:fix && npm run lint:js:fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "playwright": "^1.62.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "yaml": "^2.9.0"
  }
}
