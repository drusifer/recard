{
  "name": "recard",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ui": "node --test tests/uiActions.browser.mjs",
    "test:rtg": "node --test tests/rtgPlaythrough.browser.mjs",
    "test:hostsetup": "node --test tests/hostSetup.browser.mjs",
    "test:newgame": "node --test tests/newGame.browser.mjs",
    "test:tablezoom": "node --test tests/tableZoom.browser.mjs",
    "test:focuszoom": "node --test tests/focusZoom.browser.mjs",
    "test:multiplayer": "node --test tests/multiplayer.browser.mjs",
    "test:jevtable": "node --test tests/jevTable.browser.mjs",
    "test:spectator": "node --test tests/spectator.browser.mjs",
    "test:addbot": "node --test tests/addBot.browser.mjs",
    "test:thoughts": "node --test tests/thoughtBubble.browser.mjs",
    "test:motion": "node --test tests/cardMotion.browser.mjs",
    "test:harness-mcp": "node --test tests/harnessMcp.browser.mjs",
    "test:gin": "node --test tests/ginBot.browser.mjs",
    "test:jev-runner": "node --test tests/jevRunner.browser.mjs",
    "jev-player": "node tools/jevPlayer.mjs",
    "harness-mcp": "node tools/mcp/harnessServer.mjs",
    "dev": "node tools/devserver.mjs",
    "build:standalone": "node tools/buildStandalone.mjs",
    "build:dist": "node tools/buildDistribution.mjs",
    "cards:build": "node tools/rtg/compile.mjs",
    "cards:jobs": "node tools/rtg/genArtJobs.mjs",
    "cards:art": "node tools/imagegen/cli.mjs pack --in build/rtg-art-raw --out assets/cards/rtg",
    "lint": "npm run lint:style && npm run lint:design && npm run lint:js",
    "lint:style": "stylelint style.css",
    "lint:style:fix": "stylelint style.css --fix",
    "lint:design": "node tests/designLint.check.mjs",
    "lint:decks": "node tools/rtg/lintDecks.mjs",
    "lint:js": "eslint 'src/**/*.js' 'tools/**/*.mjs' 'tests/**/*.js' 'tests/**/*.mjs'",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:fix": "npm run lint:style:fix && npm run lint:js:fix",
    "coverage:unit": "node tools/testAudit/collectCoverage.mjs",
    "coverage:unit:deep": "node tools/testAudit/collectCoverageByCase.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@xstate/graph": "^3.0.4",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "peerjs": "^1.5.5",
    "playwright": "^1.62.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "xstate": "^5.33.2",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  }
}
